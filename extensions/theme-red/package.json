{
	"name": "theme-red",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "10.0.0",
	"publisher": "vscode",
	"license": "MIT",
	"engines": {
		"vscode": "*"
	},
	"categories": ["Themes"],
	"contributes": {
		"themes": [
			{
				"id": "Red",
				"label": "%themeLabel%",
				"uiTheme": "vs-dark",
				"path": "./themes/Red-color-theme.json"
			},
			{
				"id": "Red Light",
				"label": "%lightThemeLabel%",
				"uiTheme": "vs",
				"path": "./themes/Red-Light-color-theme.json"
			}
		],
		"configurationDefaults": {
			"workbench.colorTheme": "Red"
		}
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/microsoft/vscode.git"
	}
}
