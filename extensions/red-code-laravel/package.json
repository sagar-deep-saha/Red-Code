{
	"name": "red-code-laravel",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "0.1.0",
	"publisher": "redcode",
	"license": "MIT",
	"engines": {
		"vscode": "^1.147.0"
	},
	"main": "./out/extension.js",
	"capabilities": {
		"virtualWorkspaces": false,
		"untrustedWorkspaces": {
			"supported": "limited",
			"description": "%untrustedDescription%"
		}
	},
	"activationEvents": [
		"onView:redCode.laravel.project",
		"onView:redCode.laravel.routes",
		"onView:redCode.laravel.models",
		"onView:redCode.laravel.schema",
		"onView:redCode.laravel.env",
		"onView:redCode.laravel.logs",
		"onView:redCode.laravel.artisan"
	],
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "redCodeLaravel",
					"title": "%containerTitle%",
					"icon": "media/laravel.svg"
				}
			]
		},
		"views": {
			"redCodeLaravel": [
				{
					"id": "redCode.laravel.project",
					"name": "%projectViewTitle%"
				},
				{
					"id": "redCode.laravel.routes",
					"name": "%routesViewTitle%"
				},
				{
					"id": "redCode.laravel.models",
					"name": "%modelsViewTitle%"
				},
				{
					"id": "redCode.laravel.schema",
					"name": "%schemaViewTitle%"
				},
				{
					"id": "redCode.laravel.env",
					"name": "%envViewTitle%"
				},
				{
					"id": "redCode.laravel.logs",
					"name": "%logsViewTitle%"
				},
				{
					"id": "redCode.laravel.artisan",
					"name": "%artisanViewTitle%"
				}
			]
		},
		"commands": [
			{
				"command": "redCode.laravel.showProject",
				"title": "%showProjectCommand%",
				"category": "Laravel"
			},
			{
				"command": "redCode.laravel.refresh",
				"title": "%refreshCommand%",
				"category": "Laravel",
				"icon": "$(refresh)"
			},
			{
				"command": "redCode.laravel.palette",
				"title": "%paletteCommand%",
				"category": "Laravel",
				"icon": "$(terminal)"
			},
			{
				"command": "redCode.laravel.runArtisan",
				"title": "%runArtisanCommand%",
				"category": "Laravel"
			},
			{
				"command": "redCode.laravel.runArtisanCommand",
				"title": "%runNamedArtisanCommand%",
				"category": "Laravel"
			},
			{
				"command": "redCode.laravel.inspectClass",
				"title": "%inspectClassCommand%",
				"category": "Laravel"
			},
			{
				"command": "redCode.laravel.goToRouteAction",
				"title": "%goToRouteActionCommand%",
				"category": "Laravel"
			},
			{
				"command": "redCode.laravel.copyRouteUri",
				"title": "%copyRouteUriCommand%",
				"category": "Laravel"
			},
			{
				"command": "redCode.laravel.copyRouteCurl",
				"title": "%copyRouteCurlCommand%",
				"category": "Laravel"
			},
			{
				"command": "redCode.laravel.openRouteInBrowser",
				"title": "%openRouteInBrowserCommand%",
				"category": "Laravel"
			},
			{
				"command": "redCode.laravel.openLocation",
				"title": "%openLocationCommand%",
				"category": "Laravel"
			},
			{
				"command": "redCode.laravel.refreshEnv",
				"title": "%refreshEnvCommand%",
				"category": "Laravel",
				"icon": "$(refresh)"
			},
			{
				"command": "redCode.laravel.addMissingEnvKeys",
				"title": "%addMissingEnvKeysCommand%",
				"category": "Laravel",
				"icon": "$(add)"
			},
			{
				"command": "redCode.laravel.openEnvFile",
				"title": "%openEnvFileCommand%",
				"category": "Laravel",
				"icon": "$(go-to-file)"
			},
			{
				"command": "redCode.laravel.logs.refresh",
				"title": "%refreshLogsCommand%",
				"category": "Laravel",
				"icon": "$(refresh)"
			},
			{
				"command": "redCode.laravel.logs.filterLevels",
				"title": "%filterLogLevelsCommand%",
				"category": "Laravel",
				"icon": "$(filter)"
			},
			{
				"command": "redCode.laravel.logs.startTail",
				"title": "%startLogTailCommand%",
				"category": "Laravel",
				"icon": "$(eye)"
			},
			{
				"command": "redCode.laravel.logs.stopTail",
				"title": "%stopLogTailCommand%",
				"category": "Laravel",
				"icon": "$(eye-closed)"
			},
			{
				"command": "redCode.laravel.logs.openEntry",
				"title": "%openLogEntryCommand%",
				"category": "Laravel"
			}
		],
		"keybindings": [
			{
				"command": "redCode.laravel.palette",
				"key": "ctrl+alt+l",
				"mac": "cmd+alt+l",
				"when": "!terminalFocus"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "redCode.laravel.runArtisanCommand",
					"when": "false"
				},
				{
					"command": "redCode.laravel.openLocation",
					"when": "false"
				},
				{
					"command": "redCode.laravel.goToRouteAction",
					"when": "false"
				},
				{
					"command": "redCode.laravel.copyRouteUri",
					"when": "false"
				},
				{
					"command": "redCode.laravel.copyRouteCurl",
					"when": "false"
				},
				{
					"command": "redCode.laravel.openRouteInBrowser",
					"when": "false"
				},
				{
					"command": "redCode.laravel.refreshEnv",
					"when": "false"
				},
				{
					"command": "redCode.laravel.logs.openEntry",
					"when": "false"
				}
			],
			"view/title": [
				{
					"command": "redCode.laravel.refresh",
					"when": "view == redCode.laravel.routes || view == redCode.laravel.project || view == redCode.laravel.models || view == redCode.laravel.schema",
					"group": "navigation@1"
				},
				{
					"command": "redCode.laravel.refreshEnv",
					"when": "view == redCode.laravel.env",
					"group": "navigation@1"
				},
				{
					"command": "redCode.laravel.addMissingEnvKeys",
					"when": "view == redCode.laravel.env",
					"group": "navigation@2"
				},
				{
					"command": "redCode.laravel.openEnvFile",
					"when": "view == redCode.laravel.env",
					"group": "navigation@3"
				},
				{
					"command": "redCode.laravel.logs.refresh",
					"when": "view == redCode.laravel.logs",
					"group": "navigation@1"
				},
				{
					"command": "redCode.laravel.logs.filterLevels",
					"when": "view == redCode.laravel.logs",
					"group": "navigation@2"
				},
				{
					"command": "redCode.laravel.logs.startTail",
					"when": "view == redCode.laravel.logs && !redCodeLaravel.logTail",
					"group": "navigation@3"
				},
				{
					"command": "redCode.laravel.logs.stopTail",
					"when": "view == redCode.laravel.logs && redCodeLaravel.logTail",
					"group": "navigation@3"
				},
				{
					"command": "redCode.laravel.palette",
					"when": "view == redCode.laravel.artisan",
					"group": "navigation@1"
				}
			],
			"view/item/context": [
				{
					"command": "redCode.laravel.goToRouteAction",
					"when": "view == redCode.laravel.routes && viewItem == route",
					"group": "route@1"
				},
				{
					"command": "redCode.laravel.copyRouteUri",
					"when": "view == redCode.laravel.routes && viewItem == route",
					"group": "route@2"
				},
				{
					"command": "redCode.laravel.copyRouteCurl",
					"when": "view == redCode.laravel.routes && viewItem == route",
					"group": "route@3"
				},
				{
					"command": "redCode.laravel.openRouteInBrowser",
					"when": "view == redCode.laravel.routes && viewItem == route",
					"group": "route@4"
				}
			],
			"editor/context": [
				{
					"command": "redCode.laravel.inspectClass",
					"when": "resourceLangId == php",
					"group": "navigation@9"
				}
			]
		},
		"configuration": {
			"title": "Laravel",
			"properties": {
				"redCode.laravel.phpPath": {
					"type": "string",
					"default": "",
					"markdownDescription": "%phpPathDescription%"
				},
				"redCode.laravel.routes.showVendor": {
					"type": "boolean",
					"default": false,
					"description": "%showVendorDescription%"
				},
				"redCode.laravel.index.maxFiles": {
					"type": "number",
					"default": 20000,
					"minimum": 1000,
					"description": "%maxFilesDescription%"
				},
				"redCode.laravel.index.autoRefresh": {
					"type": "boolean",
					"default": true,
					"description": "%autoRefreshDescription%"
				},
				"redCode.laravel.envFile": {
					"type": "string",
					"default": ".env",
					"markdownDescription": "%envFileDescription%"
				},
				"redCode.laravel.logTailMb": {
					"type": "number",
					"default": 2,
					"minimum": 0.1,
					"maximum": 50,
					"description": "%logTailMbDescription%"
				},
				"redCode.laravel.test.parallel": {
					"type": "boolean",
					"default": false,
					"description": "%testParallelDescription%"
				}
			}
		},
		"configurationDefaults": {
			"files.associations": {
				"*.blade.php": "html"
			}
		}
	},
	"scripts": {
		"compile": "node ./esbuild.mts",
		"watch": "node ./esbuild.mts --watch",
		"test": "tsc -p tsconfig.json && node --test \"out/test/*.test.js\""
	},
	"devDependencies": {
		"@types/node": "24.x"
	}
}
