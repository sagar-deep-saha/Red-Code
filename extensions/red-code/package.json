{
	"name": "red-code-productivity",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "1.0.0",
	"publisher": "redcode",
	"license": "MIT",
	"engines": {
		"vscode": "^1.147.0"
	},
	"main": "./out/extension.js",
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "redCode",
					"title": "%containerTitle%",
					"icon": "media/red-code.svg"
				}
			]
		},
		"views": {
			"redCode": [
				{
					"id": "redCode.deploy",
					"name": "%deployViewTitle%",
					"contextualTitle": "%deployViewContextTitle%"
				},
				{
					"id": "redCode.bookmarks",
					"name": "%bookmarksViewTitle%",
					"contextualTitle": "%bookmarksViewContextTitle%"
				},
				{
					"id": "redCode.doctor",
					"name": "%doctorViewTitle%",
					"contextualTitle": "%doctorViewContextTitle%"
				}
			]
		},
		"commands": [
			{
				"command": "redCode.bookmarks.add",
				"title": "%addBookmarkCommand%",
				"category": "Red Code"
			},
			{
				"command": "redCode.bookmarks.addActiveFile",
				"title": "%bookmarkActiveFileCommand%",
				"category": "Red Code"
			},
			{
				"command": "redCode.bookmarks.remove",
				"title": "%removeBookmarkCommand%",
				"category": "Red Code"
			},
			{
				"command": "redCode.bookmarks.refresh",
				"title": "%refreshBookmarksCommand%",
				"category": "Red Code"
			},
			{
				"command": "redCode.doctor.scanWorkspace",
				"title": "%scanWorkspaceCommand%",
				"category": "Red Code"
			},
			{
				"command": "redCode.doctor.checkTools",
				"title": "%checkToolsCommand%",
				"category": "Red Code"
			},
			{
				"command": "redCode.deploy.pickRange",
				"title": "%selectRangeCommand%",
				"category": "Red Code",
				"icon": "$(git-compare)"
			},
			{
				"command": "redCode.deploy.pickCommits",
				"title": "%selectCommitsCommand%",
				"category": "Red Code",
				"icon": "$(list-selection)"
			},
			{
				"command": "redCode.deploy.exportZip",
				"title": "%exportZipCommand%",
				"category": "Red Code",
				"icon": "$(archive)"
			},
			{
				"command": "redCode.deploy.refresh",
				"title": "%refreshDeployCommand%",
				"category": "Red Code",
				"icon": "$(refresh)"
			},
			{
				"command": "redCode.deploy.copyPaths",
				"title": "%copyDeployPathsCommand%",
				"category": "Red Code"
			},
			{
				"command": "redCode.deploy.copyDeletions",
				"title": "%copyDeployDeletionsCommand%",
				"category": "Red Code"
			},
			{
				"command": "redCode.deploy.copyPath",
				"title": "%copyDeployPathCommand%",
				"category": "Red Code"
			},
			{
				"command": "redCode.deploy.openFile",
				"title": "%openDeployFileCommand%",
				"category": "Red Code"
			}
		],
		"configuration": {
			"title": "Red Code",
			"properties": {
				"redCode.deploy.excludePaths": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"vendor/**",
						"node_modules/**",
						"storage/**",
						"bootstrap/cache/**",
						".git/**",
						".env",
						".env.*",
						"public/hot"
					],
					"markdownDescription": "%excludePathsDescription%"
				}
			}
		},
		"menus": {
			"commandPalette": [
				{
					"command": "redCode.bookmarks.remove",
					"when": "never"
				},
				{
					"command": "redCode.deploy.copyPath",
					"when": "never"
				},
				{
					"command": "redCode.deploy.openFile",
					"when": "never"
				}
			],
			"explorer/context": [
				{
					"command": "redCode.bookmarks.add",
					"group": "navigation@8"
				}
			],
			"view/title": [
				{
					"command": "redCode.deploy.pickRange",
					"when": "view == redCode.deploy",
					"group": "navigation@1"
				},
				{
					"command": "redCode.deploy.pickCommits",
					"when": "view == redCode.deploy",
					"group": "navigation@2"
				},
				{
					"command": "redCode.deploy.exportZip",
					"when": "view == redCode.deploy",
					"group": "navigation@3"
				},
				{
					"command": "redCode.deploy.refresh",
					"when": "view == redCode.deploy",
					"group": "navigation@4"
				},
				{
					"command": "redCode.bookmarks.add",
					"when": "view == redCode.bookmarks",
					"group": "navigation@1"
				},
				{
					"command": "redCode.bookmarks.refresh",
					"when": "view == redCode.bookmarks",
					"group": "navigation@2"
				},
				{
					"command": "redCode.doctor.scanWorkspace",
					"when": "view == redCode.doctor",
					"group": "navigation@1"
				},
				{
					"command": "redCode.doctor.checkTools",
					"when": "view == redCode.doctor",
					"group": "navigation@2"
				}
			],
			"view/item/context": [
				{
					"command": "redCode.deploy.copyPath",
					"when": "view == redCode.deploy && viewItem == redCodeDeployUpload",
					"group": "1_copy@1"
				},
				{
					"command": "redCode.deploy.copyPath",
					"when": "view == redCode.deploy && viewItem == redCodeDeployDelete",
					"group": "1_copy@1"
				},
				{
					"command": "redCode.bookmarks.remove",
					"when": "view == redCode.bookmarks && viewItem == redCodeBookmark",
					"group": "inline"
				}
			]
		}
	},
	"scripts": {
		"compile": "node ./esbuild.mts",
		"watch": "node ./esbuild.mts --watch",
		"test": "tsc -p tsconfig.json && node --test out/test/bookmarkModel.test.js out/test/doctorModel.test.js out/test/deploySet.test.js out/test/zip.test.js",
		"test:git": "node ./scripts/verify-deploy.mjs"
	},
	"devDependencies": {
		"@types/node": "24.x"
	}
}
