@anthropic-ai/claude-agent-sdk/vendor/audio-capture/*-darwin/**
@anthropic-ai/claude-agent-sdk/vendor/audio-capture/*-linux/**

# node-pty ships a prebuilt module for every platform. Red Code is Windows only, and the
# foreign-platform binaries are ELF/Mach-O files that rcedit cannot stamp while packaging.
node-pty/prebuilds/darwin-*/**
node-pty/prebuilds/linux-*/**
